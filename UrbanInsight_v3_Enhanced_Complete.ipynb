      },
      "source": [
        "## ⬇️ Cell 5: Download Multi-City Data from SpaceNet (5 Cities)"
      ],
      "id": "cell_download_data"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell_5_download",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "placeholder"
      },
      "outputs": [],
      "source": [
        "# ================================================================\n",
        "# ★ CELL 5: DOWNLOAD 5 CITIES WITH UNIQUE SEEDS (70/15/15 SPLIT)\n",
        "# ================================================================\n",
        "\n",
        "import boto3\n",
        "from botocore import UNSIGNED\n",
        "from botocore.config import Config\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"DOWNLOADING 5-CITY DATASET FROM SPACENET WITH ANTI-LEAKAGE VERIFICATION\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "s3 = boto3.client(\"s3\", config=Config(signature_version=UNSIGNED))\n",
        "bucket = \"spacenet-dataset\"\n",
        "\n",
        "# ★ 5 CITIES CONFIG (Enhanced)\n",
        "CITIES = {\n",
        "    \"Vegas\": {\n",
        "        \"prefix\": \"spacenet/SN2_buildings/train/AOI_2_Vegas/\",\n",
        "        \"max_tiles\": 800,\n",
        "        \"description\": \"Las Vegas, USA (urban/desert)\"\n",
        "    },\n",
        "    \"Paris\": {\n",
        "        \"prefix\": \"spacenet/SN2_buildings/train/AOI_3_Paris/\",\n",
        "        \"max_tiles\": 400,\n",
        "        \"description\": \"Paris, France (historic/dense)\"\n",
        "    },\n",
        "    \"Shanghai\": {\n",
        "        \"prefix\": \"spacenet/SN2_buildings/train/AOI_4_Shanghai/\",\n",
        "        \"max_tiles\": 400,\n",
        "        \"description\": \"Shanghai, China (modern/high-rise)\"\n",
        "    },\n",
        "    \"Khartoum\": {\n",
        "        \"prefix\": \"spacenet/SN2_buildings/train/AOI_5_Khartoum/\",\n",
        "        \"max_tiles\": 300,\n",
        "        \"description\": \"Khartoum, Sudan (arid/sparse)\"\n",
        "    },\n",
        "    \"Rio\": {\n",
        "        \"prefix\": \"spacenet/SN2_buildings/train/AOI_1_Rio/\",\n",
        "        \"max_tiles\": 400,\n",
        "        \"description\": \"Rio de Janeiro, Brazil (coastal/mountainous)\"\n",
        "    },\n",
        "}\n",
        "\n",
        "# ★ SPLIT RATIOS\n",
        "TRAIN_RATIO = 0.70\n",
        "VAL_RATIO = 0.15\n",
        "TEST_RATIO = 0.15\n",
        "\n",
        "def get_img_idx(key: str) -> Optional[str]:\n",
        "    \"\"\"Extract image index from S3 key.\"\"\"\n",
        "    m = re.search(r'img(\\d+)', os.path.basename(key))\n",
        "    return m.group(1) if m else None\n",
        "\n",
        "# ★ SCAN S3 FOR ALL CITIES\n",
        "print(\"\\nScanning S3 buckets...\")\n",
        "city_data = {}\n",
        "\n",
        "for city, cfg in CITIES.items():\n",
        "    print(f\"\\n  [{city}] {cfg['description']}\")\n",
        "    keys = []\n",
        "    \n",
        "    try:\n",
        "        for page in s3.get_paginator(\"list_objects_v2\").paginate(\n",
        "            Bucket=bucket, \n",
        "            Prefix=cfg[\"prefix\"]\n",
        "        ):\n",
        "            for obj in page.get(\"Contents\", []):\n",
        "                keys.append((obj[\"Key\"], obj[\"Size\"]))\n",
        "    except Exception as e:\n",
        "        print(f\"    ❌ Error scanning {city}: {e}\")\n",
        "        continue\n",
        "    \n",
        "    # Match image-label pairs\n",
        "    imgs = {get_img_idx(k): k for k, s in keys if \"/PS-RGB/\" in k and k.endswith(\".tif\") and get_img_idx(k)}\n",
        "    lbls = {get_img_idx(k): k for k, s in keys if \"/geojson_buildings/\" in k and k.endswith(\".geojson\") and get_img_idx(k)}\n",
        "    \n",
        "    matched = sorted(set(imgs.keys()) & set(lbls.keys()), key=lambda x: int(x))\n",
        "    \n",
        "    # Limit tiles\n",
        "    max_t = cfg[\"max_tiles\"]\n",
        "    if len(matched) > max_t:\n",
        "        matched = matched[:max_t]\n",
        "    \n",
        "    print(f\"    ✓ {len(matched)} matched image-label pairs\")\n",
        "    city_data[city] = {\"imgs\": imgs, \"lbls\": lbls, \"matched\": matched}\n",
        "\n",
        "# ★ SPLIT WITH UNIQUE SEEDS (ANTI-LEAKAGE)\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"SPLITTING DATA (70/15/15) — UNIQUE SEED PER CITY\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "split_plan = {\"train\": {}, \"val\": {}, \"test\": {}}\n",
        "\n",
        "for city in CITIES.keys():\n",
        "    if city not in city_data:\n",
        "        print(f\"  {city}: ⚠️  No data available\")\n",
        "        continue\n",
        "    \n",
        "    matched = city_data[city][\"matched\"]\n",
        "    n = len(matched)\n",
        "    \n",
        "    # ★ UNIQUE SEED PER CITY (Fix from v2)\n",
        "    city_seed = get_city_seed(city)\n",
        "    random.seed(city_seed)\n",
        "    shuffled = matched.copy()\n",
        "    random.shuffle(shuffled)\n",
        "    \n",
        "    n_train = int(n * TRAIN_RATIO)\n",
        "    n_val = int(n * VAL_RATIO)\n",
        "    \n",
        "    train_idx = shuffled[:n_train]\n",
        "    val_idx = shuffled[n_train:n_train + n_val]\n",
        "    test_idx = shuffled[n_train + n_val:]\n",
        "    \n",
        "    # ★ ANTI-LEAKAGE VERIFICATION\n",
        "    sets = [set(train_idx), set(val_idx), set(test_idx)]\n",
        "    assert len(sets[0] & sets[1]) == 0, f\"{city} train-val overlap!\"\n",
        "    assert len(sets[0] & sets[2]) == 0, f\"{city} train-test overlap!\"\n",
        "    assert len(sets[1] & sets[2]) == 0, f\"{city} val-test overlap!\"\n",
        "    \n",
        "    split_plan[\"train\"][city] = train_idx\n",
        "    split_plan[\"val\"][city] = val_idx\n",
        "    split_plan[\"test\"][city] = test_idx\n",
        "    \n",
        "    print(f\"  {city:12s} → train={len(train_idx):4d} | val={len(val_idx):3d} | test={len(test_idx):3d} (seed={city_seed})\")\n",
        "\n",
        "print(\"\\n✓ Split plan created with zero leakage verification!\")"
      ],
      "id": "cell_5_download"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "cell_download_files"
      },
      "source": [
        "## 💾 Cell 6: Download Image and Label Files from S3"
      ],
      "id": "cell_download_files"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell_6_s3_download",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "placeholder"
      },
      "outputs": [],
      "source": [
        "# ================================================================\n",
        "# ★ CELL 6: DOWNLOAD FILES FROM S3 TO LOCAL STORAGE\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"DOWNLOADING FILES FROM S3...\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "def download_split(city: str, indices: List[str], split_name: str) -> int:\n",
        "    \"\"\"Download all images and labels for a city split.\"\"\"\n",
        "    if city not in city_data:\n",
        "        return 0\n",
        "    \n",
        "    imgs = city_data[city][\"imgs\"]\n",
        "    lbls = city_data[city][\"lbls\"]\n",
        "    \n",
        "    local_dir = os.path.join(DATA, \"splits\", split_name, city)\n",
        "    os.makedirs(os.path.join(local_dir, \"PS-RGB\"), exist_ok=True)\n",
        "    os.makedirs(os.path.join(local_dir, \"geojson_buildings\"), exist_ok=True)\n",
        "    \n",
        "    count = 0\n",
        "    for idx in indices:\n",
        "        if idx not in imgs or idx not in lbls:\n",
        "            continue\n",
        "        \n",
        "        for key in [imgs[idx], lbls[idx]]:\n",
        "            fname = os.path.basename(key)\n",
        "            subdir = \"PS-RGB\" if \"PS-RGB\" in key else \"geojson_buildings\"\n",
        "            local = os.path.join(local_dir, subdir, fname)\n",
        "            \n",
        "            if not os.path.exists(local):\n",
        "                try:\n",
        "                    s3.download_file(bucket, key, local)\n",
        "                    count += 1\n",
        "                except OSError as e:\n",
        "                    print(f\"    ❌ Disk full or IO error: {e}\")\n",
        "                    return count\n",
        "                except Exception as e:\n",
        "                    print(f\"    ⚠️  {e}\")\n",
        "    \n",
        "    return count\n",
        "\n",
        "total_downloaded = 0\n",
        "download_log = []\n",
        "\n",
        "for split_name in [\"train\", \"val\", \"test\"]:\n",
        "    print(f\"\\n  {split_name.upper()}:\")\n",
        "    for city in split_plan[split_name]:\n",
        "        n = download_split(city, split_plan[split_name][city], split_name)\n",
        "        total_downloaded += n\n",
        "        if n > 0:\n",
        "            msg = f\"    {city}: {n} files\"\n",
        "            print(msg)\n",
        "            download_log.append(msg)\n",
        "\n",
