        "## 🛠️ Cell 4: Helper Functions & Utilities"
      ],
      "id": "cell_helper_functions"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell_4_helpers",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "placeholder"
      },
      "outputs": [],
      "source": [
        "# ================================================================\n",
        "# ★ CELL 4: HELPER FUNCTIONS\n",
        "# ================================================================\n",
        "\n",
        "import re\n",
        "import random\n",
        "import shutil\n",
        "from datetime import datetime\n",
        "from typing import List, Dict, Tuple, Optional\n",
        "\n",
        "# ★ 4.1: Data Leakage Detection\n",
        "def calculate_image_hash(image_path: str) -> str:\n",
        "    \"\"\"Calculate SHA256 hash of image file.\"\"\"\n",
        "    sha256_hash = hashlib.sha256()\n",
        "    with open(image_path, \"rb\") as f:\n",
        "        for byte_block in iter(lambda: f.read(4096), b\"\"):\n",
        "            sha256_hash.update(byte_block)\n",
        "    return sha256_hash.hexdigest()\n",
        "\n",
        "def verify_no_data_leakage(train_dir: str, val_dir: str, test_dir: str) -> Dict:\n",
        "    \"\"\"Verify zero overlap between train/val/test using image hashes.\"\"\"\n",
        "    print(\"\\n\" + \"=\"*60)\n",
        "    print(\"VERIFYING DATA LEAKAGE (SHA256 Hash Comparison)\")\n",
        "    print(\"=\"*60)\n",
        "    \n",
        "    train_images = glob.glob(os.path.join(train_dir, \"**/*.png\"), recursive=True)\n",
        "    val_images = glob.glob(os.path.join(val_dir, \"**/*.png\"), recursive=True)\n",
        "    test_images = glob.glob(os.path.join(test_dir, \"**/*.png\"), recursive=True)\n",
        "    \n",
        "    def get_hashes(img_list):\n",
        "        return {calculate_image_hash(img) for img in img_list}\n",
        "    \n",
        "    train_hashes = get_hashes(train_images)\n",
        "    val_hashes = get_hashes(val_images)\n",
        "    test_hashes = get_hashes(test_images)\n",
        "    \n",
        "    train_val_overlap = train_hashes & val_hashes\n",
        "    train_test_overlap = train_hashes & test_hashes\n",
        "    val_test_overlap = val_hashes & test_hashes\n",
        "    \n",
        "    print(f\"Train images: {len(train_images)}\")\n",
        "    print(f\"Val images: {len(val_images)}\")\n",
        "    print(f\"Test images: {len(test_images)}\")\n",
        "    \n",
        "    print(f\"\\nTrain-Val overlap: {len(train_val_overlap)} (MUST be 0)\")\n",
        "    print(f\"Train-Test overlap: {len(train_test_overlap)} (MUST be 0)\")\n",
        "    print(f\"Val-Test overlap: {len(val_test_overlap)} (MUST be 0)\")\n",
        "    \n",
        "    if train_val_overlap or train_test_overlap or val_test_overlap:\n",
        "        print(\"\\n❌ DATA LEAKAGE DETECTED!\")\n",
        "        return False\n",
        "    else:\n",
        "        print(\"\\n✓ ZERO DATA LEAKAGE VERIFIED\")\n",
        "        return True\n",
        "\n",
        "# ★ 4.2: TIF Reading with Normalization\n",
        "def read_tif_as_rgb(path: str) -> np.ndarray:\n",
        "    \"\"\"Read TIF as normalized RGB (8-bit).\"\"\"\n",
        "    with rasterio.open(path) as src:\n",
        "        img = src.read()\n",
        "        n_bands = src.count\n",
        "    \n",
        "    if n_bands >= 3:\n",
        "        rgb = img[:3].astype(np.float32).transpose(1, 2, 0)\n",
        "    elif n_bands == 1:\n",
        "        g = img[0].astype(np.float32)\n",
        "        rgb = np.stack([g, g, g], axis=-1)\n",
        "    else:\n",
        "        rgb = img[:3].astype(np.float32).transpose(1, 2, 0)\n",
        "    \n",
        "    # Normalize using 2nd-98th percentile\n",
        "    for c in range(3):\n",
        "        lo, hi = np.percentile(rgb[:, :, c], [2, 98])\n",
        "        rgb[:, :, c] = np.clip((rgb[:, :, c] - lo) / (hi - lo + 1e-9), 0, 1) * 255\n",
        "    \n",
        "    return np.clip(rgb, 0, 255).astype(np.uint8)\n",
        "\n",
        "# ★ 4.3: Unique Seed Per City (Fix for v3)\n",
        "def get_city_seed(city_name: str) -> int:\n",
        "    \"\"\"Generate deterministic but UNIQUE seed per city.\"\"\"\n",
        "    return hash(city_name) % (2**31)\n",
        "\n",
        "# ★ 4.4: Logging\n",
        "def log_event(message: str, log_file: Optional[str] = None):\n",
        "    \"\"\"Print with timestamp and optionally save to file.\"\"\"\n",
        "    timestamp = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "    log_msg = f\"[{timestamp}] {message}\"\n",
        "    print(log_msg)\n",
        "    \n",
        "    if log_file:\n",
        "        with open(log_file, \"a\") as f:\n",
        "            f.write(log_msg + \"\\n\")\n",
        "\n",
        "print(\"✓ Helper functions loaded!\")\n",
        "\n",
        "import glob\n",
        "print(\"✓ All utilities ready!\")"
      ],
      "id": "cell_4_helpers"
    },
