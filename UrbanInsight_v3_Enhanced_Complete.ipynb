      "source": [
        "## 🗺️ Cell 12: Georeferencing Pipeline (Khatua et al.)"
      ],
      "id": "cell_georeferencing"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell_12_georef",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "placeholder"
      },
      "outputs": [],
      "source": [
        "# ================================================================\n",
        "# ★ CELL 12: GEOREFERENCING PIPELINE (Algorithm 1 from Khatua et al.)\n",
        "# ================================================================\n",
        "\n",
        "from osgeo import gdal, gdalconst\n",
        "import numpy as np\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"GEOREFERENCING PIPELINE (Khatua et al.)\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "def georeference_image(\n",
        "    reference_tiff_path: str,\n",
        "    input_image_path: str,\n",
        "    output_georeferenced_path: str\n",
        ") -> bool:\n",
        "    \"\"\"Apply georeferencing from reference TIFF to input image.\n",
        "    \n",
        "    Algorithm 1 from Khatua et al. (GISTAM 2024)\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # ★ Step 1: Open reference TIFF and extract geotransform\n",
        "        ref_ds = gdal.Open(reference_tiff_path, gdalconst.GA_ReadOnly)\n",
        "        if not ref_ds:\n",
        "            print(f\"  Error opening reference: {reference_tiff_path}\")\n",
        "            return False\n",
        "        \n",
        "        geo_transform = ref_ds.GetGeoTransform()\n",
        "        projection = ref_ds.GetProjection()\n",
        "        \n",
        "        # ★ Step 2: Open input image with rasterio\n",
        "        with rasterio.open(input_image_path) as src:\n",
        "            input_data = src.read()\n",
        "            input_profile = src.profile.copy()\n",
        "        \n",
        "        # ★ Step 3: Update profile with geospatial information\n",
        "        input_profile.update(\n",
        "            transform=rasterio.transform.from_bounds(\n",
        "                geo_transform[0],\n",
        "                geo_transform[3] - geo_transform[1] * input_data.shape[1],\n",
        "                geo_transform[0] + geo_transform[1] * input_data.shape[2],\n",
        "                geo_transform[3],\n",
        "                input_data.shape[2],\n",
        "                input_data.shape[1]\n",
        "            ),\n",
        "            crs=rasterio.crs.CRS.from_wkt(projection) if projection else None\n",
        "        )\n",
        "        \n",
        "        # ★ Step 4: Write georeferenced output\n",
        "        with rasterio.open(output_georeferenced_path, 'w', **input_profile) as dst:\n",
        "            dst.write(input_data)\n",
        "        \n",
        "        ref_ds = None  # Close reference\n",
        "        return True\n",
        "    \n",
        "    except Exception as e:\n",
        "        print(f\"  Georeferencing error: {e}\")\n",
        "        return False\n",
        "\n",
        "print(\"✓ Georeferencing function defined!\")"
      ],
      "id": "cell_12_georef"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "cell_vectorization"
      },
      "source": [
        "## 🔲 Cell 13: Vectorization Pipeline (Algorithm 2 from Khatua et al.)"
      ],
      "id": "cell_vectorization"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell_13_vectorize",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "placeholder"
      },
      "outputs": [],
      "source": [
        "# ================================================================\n",
        "# ★ CELL 13: VECTORIZATION PIPELINE (Algorithm 2 from Khatua et al.)\n",
        "# ================================================================\n",
        "\n",
        "from skimage import measure\n",
        "from scipy import ndimage\n",
        "import fiona\n",
        "from fiona.crs import from_epsg\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"VECTORIZATION PIPELINE (Algorithm 2 from Khatua et al.)\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "def create_polygon_shapefile(\n",
        "    segmentation_mask: np.ndarray,\n",
        "    reference_crs: str,\n",
        "    reference_transform: object,\n",
        "    output_shapefile_path: str,\n",
        "    building_ids: List[int] = None,\n",
        "    building_types: List[str] = None\n",
        ") -> bool:\n",
        "    \"\"\"Convert segmentation mask to vector polygons shapefile.\n",
        "    \n",
        "    Algorithm 2 from Khatua et al. (GISTAM 2024)\n",
        "    \"\"\"\n",
        "    try:\n",
        "        # ★ Step 1: Extract contours from mask\n",
        "        labels = measure.label(segmentation_mask)\n",
        "        coords_list = []\n",
        "        \n",
        "        for region_id in np.unique(labels):\n",
        "            if region_id == 0:  # Skip background\n",
        "                continue\n",
        "            \n",
        "            region_mask = (labels == region_id).astype(np.uint8)\n",
        "            contours = measure.find_contours(region_mask, 0.5)\n",
        "            \n",
        "            for contour in contours:\n",
        "                # Convert pixel coordinates to world coordinates\n",
        "                coords = []\n",
        "                for row, col in contour:\n",
        "                    x, y = reference_transform * (col, row)\n",
        "                    coords.append([x, y])\n",
        "                \n",
        "                if len(coords) >= 3:\n",
        "                    coords_list.append({\n",
        "                        'id': region_id,\n",
        "                        'type': building_types[region_id] if building_types else 'building',\n",
        "                        'coordinates': coords\n",
        "                    })\n",
        "        \n",
        "        # ★ Step 2: Define schema\n",
        "        schema = {\n",
        "            'geometry': 'Polygon',\n",
        "            'properties': {\n",
        "                'id': 'int',\n",
        "                'type': 'str',\n",
        "                'area_m2': 'float'\n",
        "            }\n",
        "        }\n",
        "        \n",
        "        # ★ Step 3: Write to shapefile\n",
        "        os.makedirs(os.path.dirname(output_shapefile_path), exist_ok=True)\n",
        "        \n",
        "        with fiona.open(\n",
        "            output_shapefile_path,\n",
        "            'w',\n",
        "            driver='ESRI Shapefile',\n",
        "            schema=schema,\n",
        "            crs=reference_crs\n",
        "        ) as dst:\n",
        "            for idx, coord_data in enumerate(coords_list):\n",
        "                polygon = Polygon(coord_data['coordinates'])\n",
        "                \n",
        "                dst.write({\n",
        "                    'geometry': mapping(polygon),\n",
        "                    'properties': {\n",
        "                        'id': coord_data['id'],\n",
        "                        'type': coord_data['type'],\n",
        "                        'area_m2': polygon.area\n",
        "                    }\n",
        "                })\n",
        "        \n",
        "        return True\n",
        "    \n",
        "    except Exception as e:\n",
        "        print(f\"  Vectorization error: {e}\")\n",
        "        return False\n",
        "\n",
        "print(\"✓ Vectorization function defined!\")"
      ],
      "id": "cell_13_vectorize"
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "cell_inference"
      },
      "source": [
        "## 🔍 Cell 14: Inference Pipeline with JSON Output"
      ],
      "id": "cell_inference"
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cell_14_inference",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "placeholder"
      },
      "outputs": [],
      "source": [
        "# ================================================================\n",
        "# ★ CELL 14: INFERENCE WITH GEOREFERENCING & JSON OUTPUT\n",
        "# ================================================================\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"INFERENCE PIPELINE WITH GEOREFERENCING\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "def run_inference_with_georeferencing(\n",
        "    model: YOLO,\n",
        "    image_path: str,\n",
        "    reference_tiff_path: str = None,\n",
        "    output_dir: str = None,\n",
        "    conf_threshold: float = 0.5\n",
        ") -> Dict:\n",
        "    \"\"\"Run inference and generate georeferenced outputs with JSON metadata.\n",
        "    \n",
        "    Returns:\n",
        "        metadata_dict: Contains building detections, coordinates, areas\n",
        "    \"\"\"\n",
        "    \n",
        "    output_dir = output_dir or OUT\n",
        "    os.makedirs(output_dir, exist_ok=True)\n",
        "    \n",
        "    # ★ Step 1: Run inference\n",
        "    results = model.predict(\n",
        "        source=image_path,\n",
        "        conf=conf_threshold,\n",
        "        iou=0.6,\n",
        "        device=device,\n",
        "        verbose=False\n",
        "    )\n",
        "    \n",
        "    result = results[0]\n",
        "    \n",
        "    # ★ Step 2: Extract building detections\n",
        "    buildings = []\n",
        "    \n",
        "    if result.masks is not None:\n",
        "        masks = result.masks.data.cpu().numpy()\n",
        "        confidences = result.conf.cpu().numpy()\n",
        "        boxes = result.boxes.xyxy.cpu().numpy()\n",
        "        \n",
        "        for idx, (mask, conf, box) in enumerate(zip(masks, confidences, boxes)):\n",
        "            # ★ Calculate area from mask\n",
        "            area_pixels = np.sum(mask > 0.5)\n",
        "            \n",
        "            # Extract GSD from reference image if available\n",
        "            gsd = 0.49511590600013733  # Default from FMOW metadata\n",
        "            if reference_tiff_path:\n",
        "                with rasterio.open(reference_tiff_path) as src:\n",
        "                    gsd = src.transform[0]  # Pixel size in meters\n",
        "            \n",
        "            area_m2 = area_pixels * (gsd ** 2)\n",
        "            \n",
        "            x1, y1, x2, y2 = box\n",
        "            \n",
        "            building_entry = {\n",
        "                'id': f'building_{idx+1:05d}',\n",
        "                'confidence': float(conf),\n",
        "                'bounding_box': {\n",
        "                    'x': float(x1),\n",
        "                    'y': float(y1),\n",
        "                    'width': float(x2 - x1),\n",
        "                    'height': float(y2 - y1)\n",
        "                },\n",
        "                'area_m2': float(area_m2),\n",
        "                'area_pixels': int(area_pixels),\n",
        "                'mask': mask.tolist()  # Full segmentation mask\n",
        "            }\n",
        "            \n",
        "            buildings.append(building_entry)\n",
        "    \n",
        "    # ★ Step 3: Get image metadata\n",
        "    img_name = os.path.basename(image_path)\n",
        "    \n",
        "    if reference_tiff_path:\n",
        "        with rasterio.open(reference_tiff_path) as src:\n",
        "            gsd = src.transform[0]\n",
        "            crs = src.crs\n",
        "            transform = src.transform\n",
        "    else:\n",
        "        gsd = 0.49511590600013733\n",
        "        crs = None\n",
        "        transform = None\n",
        "    \n",
        "    # ★ Step 4: Create metadata JSON\n",
        "    metadata = {\n",
        "        'image_name': img_name,\n",
        "        'total_buildings': len(buildings),\n",
        "        'gsd': float(gsd),\n",
        "        'timestamp': datetime.now().isoformat(),\n",
        "        'coordinate_system': str(crs) if crs else 'EPSG:4326',\n",
        "        'buildings': buildings,\n",
        "        'inference_config': {\n",
        "            'model': 'yolov8m-seg',\n",
        "            'confidence_threshold': conf_threshold,\n",
        "            'device': device\n",
        "        }\n",
        "    }\n",
        "    \n",
        "    # ★ Step 5: Save outputs\n",
        "    base_name = os.path.splitext(img_name)[0]\n",
        "    \n",
        "    # Save JSON\n",
        "    json_path = os.path.join(output_dir, f\"{base_name}_detections.json\")\n",
        "    with open(json_path, 'w') as f:\n",
        "        json.dump(metadata, f, indent=2)\n",
        "    \n",
        "    # Save visualization\n",
        "    if hasattr(result, 'plot'):\n",
        "        plot_img = result.plot()\n",
        "        plot_path = os.path.join(output_dir, f\"{base_name}_visualization.png\")\n",
        "        cv2.imwrite(plot_path, cv2.cvtColor(plot_img, cv2.COLOR_RGB2BGR))\n",
        "    \n",
        "    print(f\"  ✓ Detected {len(buildings)} buildings\")\n",
        "    print(f\"  ✓ JSON saved: {json_path}\")\n",
        "    \n",
        "    return metadata\n",
        "\n",
        "print(\"✓ Inference function defined!\")"
      ],
      "id": "cell_14_inference"
    },
