      "outputs": [],
      "source": [
        "# ================================================================\n",
        "# ★ CELL 10: CUSTOM TRAINING WITH BACKBONE FREEZING & MONITORING\n",
        "# ================================================================\n",
        "\n",
        "from ultralytics import YOLO\n",
        "import copy\n",
        "\n",
        "print(\"\\n\" + \"=\"*70)\n",
        "print(\"INITIALIZING YOLOV8-SEG MODEL FOR TRAINING\")\n",
        "print(\"=\"*70)\n",
        "\n",
        "def train_with_backbone_freezing(\n",
        "    yaml_path: str,\n",
        "    epochs: int = 100,\n",
        "    freeze_backbone_epochs: int = 3,\n",
        "    checkpoint_dir: str = None,\n",
        "    save_dir: str = None\n",
        ") -> Tuple[YOLO, Dict]:\n",
        "    \"\"\"Train YOLOv8-seg with backbone freezing strategy.\n",
        "    \n",
        "    Args:\n",
        "        yaml_path: Path to dataset.yaml\n",
        "        epochs: Total epochs\n",
        "        freeze_backbone_epochs: Epochs to freeze backbone\n",
        "        checkpoint_dir: Where to save checkpoints\n",
        "        save_dir: Where to save results\n",
        "    \n",
        "    Returns:\n",
        "        (trained_model, training_log)\n",
        "    \"\"\"\n",
        "    \n",
        "    # Load pretrained YOLOv8-seg\n",
        "    model = YOLO('yolov8m-seg.pt')\n",
        "    \n",
        "    print(f\"\\n✓ Model loaded\")\n",
        "    print(f\"  Device: {device}\")\n",
        "    print(f\"  Model: yolov8m-seg\")\n",
        "    print(f\"  Backbone freeze epochs: {freeze_backbone_epochs}\")\n",
        "    \n",
        "    # ★ PHASE 1: FREEZE BACKBONE (First 3 epochs)\n",
        "    print(f\"\\n{'='*70}\")\n",
        "    print(f\"PHASE 1: BACKBONE FREEZING (Epochs 1-{freeze_backbone_epochs})\")\n",
        "    print(f\"{'='*70}\")\n",
        "    \n",
        "    # Freeze backbone parameters\n",
        "    freeze_list = ['model.0', 'model.1', 'model.2', 'model.3', 'model.4', 'model.5', 'model.6', 'model.7', 'model.8', 'model.9']\n",
        "    \n",
        "    for param in model.model.parameters():\n",
        "        param.requires_grad = False\n",
        "    \n",
        "    # Unfreeze detection heads\n",
        "    for param in model.model.model[-2].parameters():\n",
        "        param.requires_grad = True\n",
        "    for param in model.model.model[-1].parameters():\n",
        "        param.requires_grad = True\n",
        "    \n",
        "    print(\"  → Backbone frozen, detection heads active\")\n",
        "    \n",
        "    # Train phase 1\n",
        "    results_phase1 = model.train(\n",
        "        data=yaml_path,\n",
        "        epochs=freeze_backbone_epochs,\n",
        "        imgsz=640,\n",
        "        batch=16,\n",
        "        device=device,\n",
        "        lr0=0.0003,\n",
        "        lrf=0.01,\n",
        "        cos_lr=True,\n",
        "        dropout=0.1,\n",
        "        weight_decay=0.0005,\n",
        "        patience=7,\n",
        "        save_period=5,\n",
        "        mosaic=1.0,\n",
        "        copy_paste=0.1,\n",
        "        flipud=0.5,\n",
        "        fliplr=0.5,\n",
        "        degrees=10,\n",
        "        translate=0.1,\n",
        "        scale=0.5,\n",
        "        verbose=True,\n",
        "        project=checkpoint_dir,\n",
        "        name='phase1_backbone_frozen'\n",
        "    )\n",
        "    \n",
        "    print(f\"\\n✓ Phase 1 complete\")\n",
        "    \n",
        "    # ★ PHASE 2: UNFREEZE BACKBONE (Remaining epochs)\n",
        "    print(f\"\\n{'='*70}\")\n",
        "    print(f\"PHASE 2: FULL TRAINING (Epochs {freeze_backbone_epochs+1}-{epochs})\")\n",
        "    print(f\"{'='*70}\")\n",
        "    \n",
        "    # Unfreeze all parameters\n",
        "    for param in model.model.parameters():\n",
        "        param.requires_grad = True\n",
        "    \n",
        "    print(\"  → All parameters unfrozen\")\n",
        "    \n",
        "    # Train phase 2 with mosaic closure at epoch 40\n",
        "    remaining_epochs = epochs - freeze_backbone_epochs\n",
        "    \n",
        "    results_phase2 = model.train(\n",
        "        data=yaml_path,\n",
        "        epochs=remaining_epochs,\n",
        "        imgsz=640,\n",
        "        batch=16,\n",
        "        device=device,\n",
        "        lr0=0.0003,\n",
        "        lrf=0.01,\n",
        "        cos_lr=True,\n",
        "        dropout=0.1,\n",
        "        weight_decay=0.0005,\n",
        "        patience=7,\n",
        "        save_period=5,\n",
        "        mosaic=0.7,  # Reduce mosaic\n",
        "        copy_paste=0.1,\n",
        "        flipud=0.5,\n",
        "        fliplr=0.5,\n",
        "        degrees=10,\n",
        "        translate=0.1,\n",
        "        scale=0.5,\n",
        "        verbose=True,\n",
        "        project=checkpoint_dir,\n",
        "        name='phase2_full_training',\n",
        "        resume=True  # Resume from phase 1\n",
        "    )\n",
        "    \n",
        "    print(f\"\\n✓ Phase 2 complete\")\n",
        "    \n",
        "    return model, {'phase1': results_phase1, 'phase2': results_phase2}\n",
        "\n",
        "print(\"✓ Training function defined!\")"
      ],
      "id": "cell_10_trainer"
    },
